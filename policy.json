{
  "version": 1,
  "_terminal_ask_note": "terminal_ask_mode：\"ask\"（默认）= 机密路径/不可逆动作弹窗让人确认，用户点一下就继续；\"deny\" = 直接拒绝、不弹窗，更严格但会卡住任务（用户只能在对话里确认后重试）。",
  "terminal_ask_mode": "ask",
  "_note": "ZCode PermissionRequest hook 的策略表。allow = 可证明只读才自动放行；deny = 不可逆的危险动作直接拒；两者都不命中时交给 model_review 让模型看一眼，模型也不放行才退回人工审批。改完存盘即生效，不需要重启（脚本每次调用都重新读取）。",
  "sensitive": {
    "_note": "命中即强制人工确认，且不再交给模型审查——模型判断不了一个路径是不是机密。放在 deny 之后、只读白名单之前：只读白名单是看命令形状的，不看路径，否则 cat ~/.ssh/id_rsa 会被零审查放行。",
    "rules": [
      { "re": "\\.(ssh|gnupg|aws|kube)\\b|\\.docker/config\\.json", "why": "密钥或凭据目录" },
      { "re": "id_(rsa|dsa|ecdsa|ed25519)", "why": "SSH 私钥" },
      { "re": "(credentials?|secrets?)\\.(json|ya?ml|toml|ini)", "why": "凭据文件" },
      { "re": "\\.(netrc|npmrc|pypirc|git-credentials|pgpass)", "why": "凭据文件" },
      { "re": "keychain", "why": "系统钥匙串" },
      { "re": "\\.env\\b", "why": ".env 里的密钥" }
    ]
  },
  "always_ask": {
    "_note": "不可逆但合法、且日常不常见的动作：强制人工确认，不交给模型（模型判断不了后果有多难撤销）。放这里的判据是「罕见 + 难以撤回」——别塞日常高频操作，否则又退回逐条点。",
    "rules": [
      { "re": "\\b(npm|cargo|gem|yarn|pnpm)\\s+publish\\b|\\btwine\\s+upload\\b|\\bdocker\\s+push\\b|\\bgh\\s+release\\s+create\\b", "why": "发布到包/镜像仓库（发出即无法撤回）" },
      { "re": "\\bgit\\s+(filter-branch|filter-repo)\\b|\\bgit\\s+reflog\\s+expire\\b|\\bgit\\s+gc\\b[^|;]*--prune=now", "why": "重写 git 历史" },
      { "re": "\\bdrop\\s+(table|database|schema|index)\\b|\\btruncate\\s+table\\b|flushall|flushdb|dropDatabase", "why": "清空数据库对象" },
      { "re": "\\blaunchctl\\s+(load|bootstrap)\\b|\\bcrontab\\b(?!\\s+-l)|\\bsystemctl\\s+(enable|start)\\b", "why": "安装开机/定时持久化任务" },
      { "re": "\\b(npm|yarn|pnpm|pip3?|cargo|gem)\\s+config\\s+set\\b", "why": "改包管理器源（可被指向恶意仓库）" },
      { "re": "\\bpfctl\\b|\\bnetworksetup\\s+-|\\bifconfig\\s+\\w+\\s+(up|down)|\\broute\\s+(add|delete)\\b", "why": "改网络/防火墙配置" },
      { "re": "\\bkill\\s+-9\\s+-1\\b|\\bkillall\\s+-9\\s+(\\*|all)\\b", "why": "强杀全部进程" },
      { "re": "\\bgit\\s+config\\s+(?:(--unset|--unset-all|--edit|-e|--add|--replace-all|--rename-section|--remove-section)\\b.*|((--global|--local|--system|--worktree)\\s+)?[^\\s-]\\S*\\s+\\S+)", "why": "写 git 配置（core.pager / alias.* / url.*.insteadOf 都能劫持执行）" },
      { "re": "\\bhistory\\s+-c\\b|\\brm\\b[^|;]*\\.(zsh|bash)_history", "why": "清除 shell 历史" }
    ]
  },
  "trusted_remote": {
    "_note": "把文件/命令送到你自己的服务器：只有目标是下面白名单里的主机时才自动放行 scp/sftp/rsync；ssh 则要求「主机可信 + 远端要执行的命令本身通过本地检查」。陌生主机一律照旧走模型审查（保留「往陌生地址外发数据要问」这条防线）。",
    "hosts": ["myserver"],
    "upload_commands": ["scp", "sftp", "rsync"],
    "shell_commands": ["ssh"],
    "_modes_note": "上传类：所有远端目标都必须在 hosts 里才放行。ssh：主机可信后，把引号里的远端命令取出来递归过一遍本地规则（deny 仍然优先，白名单/已学规则命中才放行，其余交模型）。"
  },
  "web": {
    "_note": "WebFetch / WebSearch 自动放行。这两个工具不执行本地命令，风险面是「把外部内容带进上下文」（prompt injection，审查提示词已把工具输出标为 UNTRUSTED）与「借 URL 外发数据」（需要 agent 先拿到秘密，而读凭据已被 sensitive 层强制人工）。用 curl 抓网页本来就已本地放行，所以这一层不新增能力面。默认只把本机地址与黑名单域名交回人工。",
    "enabled": true,
    "tools": ["WebFetch", "WebSearch", "web_search"],
    "block_localhost": true,
    "blocked_hosts": [],
    "_tools_note": "ZCode 里 WebFetch 的权限描述是 needsApproval:true / sideEffectScope:network，所以每个新域名都会问一次；WebSearch 是 needsApproval:false，本来就不问。要覆盖这两个工具，hook 的 matcher 必须写上它们（大小写敏感），只写 Bash 不会生效。"
  },
  "learn": {
    "_note": "学习式前缀规则：只从「模型判 ALLOW」的简单命令里学 token 前缀（仿 Codex 的 prefix_rule），下次同类命令直接本地放行。头不在 heads/subcommand_heads/run_heads 里的一律不学 —— 解释器（python/node/sh）、安装、删除、网络外发类永不学习。规则存在 learned-rules.json，可 --learned 查看、--forget 删除。",
    "enabled": true,
    "min_observations": 2,
    "ttl_days": 30,
    "max_rules": 200,
    "heads": ["pytest", "ruff", "black", "isort", "mypy", "flake8", "eslint", "prettier", "tsc", "vitest", "jest", "playwright", "make", "cmake", "ninja", "bazel", "tsx", "gradlew"],
    "subcommand_heads": ["cargo", "go", "git", "gradle", "mvn", "swift", "xcodebuild", "adb", "flutter", "dart"],
    "run_heads": ["npm", "pnpm", "yarn", "bun"],
    "extra_forbid_tokens": ["install", "add", "remove", "rm", "prune", "uninstall", "update", "upgrade", "publish", "push", "deploy", "init", "create", "new", "delete", "drop", "clean", "shell", "-i", "-f", "--force", "--hard", "--delete", "-exec", "--exec", "-y", "--yes", "--global", "-g", "sudo"]
  },
  "model_review": {
    "_note": "本地规则判不准时的二次审查。关思考 + 极小 max_tokens + 本地缓存，尽量少烧 token。baseURL/apiKey 从 app 的 provider 配置里按 provider_id 取，不在这里重复存密钥。",
    "enabled": true,
    "provider_id": "YOUR-PROVIDER-ID",
    "model": "z-ai/glm-5.3-flash",
    "_model_note": "实测：glm-5.3-flash + reasoning_effort=low 可把思考压到 0（reasoning_tokens=0），每次审查约 130~160 token；deepseek-v4.1-flash 是强制思考模型，reasoning 吃满预算且可能吐不出结论，约 250 token。",
    "app_config": "~/.zcode/v2/config.json",
    "timeout_ms": 12000,
    "max_tokens": 160,
    "max_command_chars": 12000,
    "cache_ttl_s": 86400,
    "reasoning_effort": "low",
    "user_agent": "ZCode/3.11.2",
    "never_ask": false,
    "_never_ask_note": "false（默认）= 模型可以三选一：ALLOW / DENY（明确有害，硬阻断）/ ASK（不确定，交人工）。\n    true = 取消 ASK，模型必须二选一，所有拒绝都变成硬阻断。\n    为什么默认 false：实测按项目统计，用户自己的项目里只有 2%~4% 的命令会弹窗，而这些弹窗几乎都是「模型缺少授权上下文」造成的误判（例：用户刚要求过的推送、读代码、改配置）。把它们变成硬阻断会直接卡住用户交代的任务，代价远大于多点一下。",
    "context_messages": 4,
    "context_chars": 1600,
    "use_user_context": true,
    "breaker_consecutive_error": 3,
    "breaker_consecutive_ask": 0,
    "breaker_cooldown_s": 120
  },
  "allow": [
    { "re": "^\\s*(ls|pwd|echo|printf)\\b", "why": "只读输出" },
    { "re": "^\\s*cd\\b", "why": "只切换目录，本身无副作用" },
    { "re": "^\\s*(cat|head|tail|tac|nl)\\b", "why": "读文件内容" },
    { "re": "^\\s*(wc|stat|file|tree|du|df|basename|dirname|realpath|readlink)\\b", "why": "读元信息" },
    { "re": "^\\s*(md5|md5sum|shasum|cksum|sha256sum|diff|cmp)\\b", "why": "校验与比较" },
    { "re": "^\\s*(which|type|command\\s+-v)\\b", "why": "查可执行文件位置" },
    { "re": "^\\s*env\\s*$", "why": "打印环境变量（仅裸 env，带赋值会执行命令）" },
    { "re": "^\\s*printenv\\b", "why": "打印环境变量" },
    { "re": "^\\s*export\\s+(-p\\s*$|[A-Za-z_][A-Za-z0-9_]*=)", "why": "export 变量赋值（只影响本条命令的环境）" },
    { "re": "^\\s*(date|uname|sw_vers|hostname|uptime|id|whoami|locale|sleep)\\b", "why": "系统信息 / 等待" },
    { "re": "^\\s*(ps|lsof|netstat|vm_stat|system_profiler)\\b", "why": "查看进程/连接/资源" },
    { "re": "^\\s*(grep|egrep|fgrep|rg)\\b", "why": "搜索文本" },
    { "re": "^\\s*(sort|uniq|cut|tr|jq|column|paste|comm|join|fold)\\b", "why": "文本流处理" },
    { "re": "^\\s*(test|\\[|\\[\\[|true|false|:)(\\s|$)", "why": "条件测试（[ / test / true / :），只读无副作用" },
    { "re": "^\\s*sed\\b(?![\\s\\S]*\\s-i(?:\\s|$|\\.))", "why": "sed 不加 -i 时只输出到 stdout（-i 会原地改文件，故排除）" },
    { "re": "^\\s*find\\b(?![^|]*-delete)(?![^|]*-exec)(?![^|]*-execdir)(?![^|]*-fprint)", "why": "find 查找（排除 -delete/-exec/-fprint）" },
    { "re": "^\\s*mdfind\\b", "why": "Spotlight 查找" },
    { "re": "^\\s*mdls\\b", "why": "读 Spotlight 元数据" },
    { "re": "^\\s*plutil\\s+(-p|-lint)\\b", "why": "读 plist" },
    { "re": "^\\s*defaults\\s+read\\b", "why": "读偏好设置（write 不匹配）" },
    { "re": "^\\s*xattr\\s+(-l|-p)\\b", "why": "读扩展属性（-d/-w 会写）" },
    { "re": "^\\s*[A-Za-z_][A-Za-z0-9_]*=\\S*$", "why": "单个纯变量赋值（带后续命令的 env 前缀不匹配）" },
    { "re": "^\\s*codesign\\s+(-[a-zA-Z]*[dv][a-zA-Z]*|--verify|--display)\\b", "why": "校验签名" },
    { "re": "^\\s*launchctl\\s+(list|getenv|print|blame)\\b", "why": "查 launchd（unload/bootout 不匹配）" },
    { "re": "^\\s*(od|xxd|hexdump|strings|nm|size|otool)\\b", "why": "二进制/十六进制查看" },
    { "re": "^\\s*git\\s+config\\s+((--global|--local|--system|--worktree)\\s+)?(--get|--get-all|--get-regexp|--list|-l|--show-origin|--show-scope)\\b", "why": "读 git 配置（带显式读取 flag）" },
    { "re": "^\\s*git\\s+config\\s+((--global|--local|--system|--worktree)\\s+)?[A-Za-z0-9][A-Za-z0-9._-]*\\s*$", "why": "读 git 配置（无 flag 的单个 key；带值的写入形式与 -e/-e 之类不匹配）" },
    { "re": "^\\s*git\\s+(status|diff|log|show|branch|remote|rev-parse|ls-files|ls-tree|describe|blame|shortlog|tag|for-each-ref|stash\\s+list|worktree\\s+list|config\\s+--get(-all)?)\\b", "why": "git 只读子命令" },
    { "re": "^\\s*7zz\\s+(l|t)\\b", "why": "7-Zip 列表/测试（x 会解包写盘）" },
    { "re": "^\\s*mkdir\\b", "why": "创建目录" },
    { "re": "^\\s*touch\\b", "why": "创建空文件/更新时间戳" },
    { "re": "^\\s*tar\\s+((?:-[a-zA-Z]*)?t[a-zA-Z]*|--list)\\s", "why": "tar 列表（解包 x 会写盘，不匹配）" },
    { "re": "^\\s*(curl|wget)\\b(?![\\s\\S]*?(--data|--upload-file|--form|--post|--json|\\s-[XTudF]\\s))", "why": "网络下载/GET（带上传语义的不匹配）" },
    { "re": "^\\s*unzip\\s+-l\\b", "why": "zip 列表" },
    { "re": "^\\s*node\\s+--check\\b", "why": "语法检查，不执行" },
    { "re": "^\\s*python3?\\s+-m\\s+json\\.tool\\b", "why": "JSON 格式化校验" },
    { "re": "^\\s*sqlite3\\b(?![\\s\\S]*?(insert|update|delete|drop|alter|create|attach|vacuum|detach|replace\\s+into))(?=[\\s\\S]*?(\\.tables|\\.schema|\\.indexes|\\.databases|\\.fullschema|select|pragma))", "why": "sqlite3 只读查询（排除写操作）" }
  ],
  "deny": [
    { "re": "\\brm\\s+(-[a-zA-Z]+\\s+)*(~|\\$HOME)/?\\*?(\\s|$)", "why": "删除家目录" },
    { "re": "\\brm\\s+(-[a-zA-Z]+\\s+)*/(\\s|\\*|$)", "why": "删除根目录" },
    { "re": "\\brm\\s+(-[a-zA-Z]+\\s+)*(\\*|/\\*)(\\s|$)", "why": "通配删除当前目录全部内容" },
    { "re": "\\bsudo\\b|\\bsu\\s+(-|root)", "why": "提权执行" },
    { "re": "\\bdd\\b[^|;]*of=/dev/", "why": "直接写裸设备" },
    { "re": "\\b(mkfs|newfs)\\b|diskutil\\s+(erase|reformat|partition)", "why": "格式化/分区磁盘" },
    { "re": "\\b(shutdown|reboot|halt)\\b", "why": "关机/重启" },
    { "re": ":\\(\\)\\s*\\{", "why": "fork bomb" },
    { "re": "chmod\\s+-R\\s+[0-7]*777\\s+/", "why": "放开根目录权限" },
    { "re": "(curl|wget)\\b[^|;]*\\|\\s*(sudo\\s+)?(ba|z|k)?sh\\b", "why": "下载内容直接交给 shell 执行" },
    { "re": "git\\s+push\\b[^|;]*(--force(?!-with-lease)|\\s-f\\b)", "why": "强制推送（--force-with-lease 除外）" },
    { "re": "git\\s+reset\\s+--hard|git\\s+clean\\s+-[a-zA-Z]*[fdx]", "why": "丢弃未提交改动" },
    { "re": ">\\s*/dev/(sd|disk|rdisk)", "why": "覆写裸设备" },
    { "re": "(>>?|tee)\\s+[\"']?[^\\s\"']*/(etc|usr|System|Library|bin|sbin|private)/", "why": "写系统目录" },
    { "re": "(>>?|tee)\\s+[\"']?[^\\s\"']*(\\.ssh|\\.aws|\\.gnupg|\\.netrc|keychains?)/", "why": "写凭据目录" },
    { "re": "(>>?|tee)\\s+[\"']?[^\\s\"']*(\\.zshrc|\\.zprofile|\\.zshenv|\\.bashrc|\\.bash_profile|\\.gitconfig)", "why": "改 shell/配置启动文件" },
    { "re": "csrutil\\s+disable|spctl\\s+--master-disable|launchctl\\s+(unload|bootout|remove)\\b", "why": "关系统安全机制" },
    { "re": "\\bnvram\\s+-d\\b|\\bbless\\b", "why": "改固件/启动项" }
  ]
}
